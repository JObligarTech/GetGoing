# ── Supabase ───────────────────────────────────────────────────────────────
# Both values are safe to expose to browsers; RLS is what protects data.
# Get them from: Supabase dashboard → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-me

# NEVER put SUPABASE_SERVICE_ROLE_KEY in any app .env. It is not read by this codebase.

# ── Web ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Providers (all optional — mock adapters are used when unset) ───────────
# TRANSLATION_PROVIDER=mock | google
# FX_PROVIDER=mock | frankfurter
# GEOCODE_PROVIDER=mock | nominatim
