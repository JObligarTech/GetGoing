# ── Supabase ───────────────────────────────────────────────────────────────
# Both values are safe to expose to browsers; RLS is what protects data.
# Get them from: Supabase dashboard → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-me

# NEVER put SUPABASE_SERVICE_ROLE_KEY in any app .env. It is not read by this codebase.

# ── Web ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Providers ──────────────────────────────────────────────────────────────
# Demo mode and tests always use the offline mocks. A real deployment (Supabase configured) uses
# Frankfurter (rates), Nominatim (place search) and OSRM (walk / cycle / drive) automatically, and
# DeepL / Google Vision when their key is set. Step-by-step: docs/SETUP.md.
# Server-only keys (web app / host env only, never NEXT_PUBLIC_ or EXPO_PUBLIC_):
# DEEPL_API_KEY=                     (DeepL API; Free-plan keys end in ":fx")
# GOOGLE_VISION_API_KEY=             (Google Cloud Vision, restricted to the Cloud Vision API)
# Optional overrides — each beats the automatic choice:
# TRANSLATION_PROVIDER=deepl | mock
# OCR_PROVIDER=google-vision | mock
# FX_PROVIDER=frankfurter | mock      EXPO_PUBLIC_FX_PROVIDER=frankfurter | mock
# GEOCODE_PROVIDER=nominatim | mock
# ROUTING_PROVIDER=osrm | mock        (transit stays an estimate)
# OSRM_URL=https://router.project-osrm.org      EXPO_PUBLIC_OSRM_URL=
# Public web app the mobile app talks to: invites (/join/…), claim links (/s/…), gift links (/gift/…),
# and the translation / photo relay (/api/v1/translate, /api/v1/ocr) that keeps provider keys off the phone.
EXPO_PUBLIC_SITE_URL=https://getgoing.app

# ── Billing (Atlas Premium Pass) ───────────────────────────────────────────
# No billing vendor is configured yet: purchases report "unavailable" outside demo mode.
# When one is chosen, its webhook posts to the billing-webhook Edge Function, whose secrets are set with
# `supabase secrets set BILLING_WEBHOOK_SECRET=…` — never in an app .env.
