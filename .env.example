# ── Supabase ───────────────────────────────────────────────────────────────
# Both values are safe to expose to browsers; RLS is what protects data.
# Get them from: Supabase dashboard → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-me

# NEVER put SUPABASE_SERVICE_ROLE_KEY in any app .env. It is not read by this codebase.

# ── Web ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Providers (all optional — mock adapters are used when unset) ───────────
# TRANSLATION_PROVIDER=mock         (a keyed provider slots in behind packages/core/src/providers/types.ts; web calls it server-side only)
# EXPO_PUBLIC_FX_PROVIDER=frankfurter (mobile: live keyless rates on-device; empty = mock)
# FX_PROVIDER=mock | frankfurter
# GEOCODE_PROVIDER=mock | nominatim
# ROUTING_PROVIDER=mock | osrm        (walk / cycle / drive via OSRM; transit stays on the mock)
# OSRM_URL=https://router.project-osrm.org
# EXPO_PUBLIC_OSRM_URL=
# Public site the mobile app links to for invites (/join/…), claim links (/s/…) and gift links (/gift/…).
EXPO_PUBLIC_SITE_URL=https://voya.app               (mobile routes on-device; empty = mock)

# ── Billing (Atlas Premium Pass) ───────────────────────────────────────────
# No billing vendor is configured yet: purchases report "unavailable" outside demo mode.
# When one is chosen, its webhook posts to the billing-webhook Edge Function, whose secrets are set with
# `supabase secrets set BILLING_WEBHOOK_SECRET=…` — never in an app .env.
