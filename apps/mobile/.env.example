# Copy to .env (gitignored). Leave EXPO_PUBLIC_SUPABASE_URL empty to run in demo mode (Expo Go, no backend, offline mocks).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The deployed web app. Real translation and photo reading go through its relay (/api/v1/*),
# so the DeepL and Google Vision keys never ship in the app. Also used for invite, claim and gift links.
EXPO_PUBLIC_SITE_URL=https://getgoing.app
# Optional: your own OSRM server for walk / cycle / drive directions.
# Empty = the public OSRM server when Supabase is configured, the offline mock in demo mode.
EXPO_PUBLIC_OSRM_URL=
# Optional: force exchange rates to "mock" or "frankfurter" (default: frankfurter when Supabase is configured).
EXPO_PUBLIC_FX_PROVIDER=
